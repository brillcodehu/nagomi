# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/nagomi

# NextAuth
NEXTAUTH_SECRET=your-secret-key
NEXTAUTH_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend
RESEND_API_KEY=re_...

# Admin
ADMIN_EMAIL=talk@nagomi-pilates.hu

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Webhelyadatok (nem kötelező, az alapérték a nagomi-pilates.hu)
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_PHONE=
# NEXT_PUBLIC_ADDRESS=
# EMAIL_FROM_ADDRESS=

# Indexelés: alapból tiltott, csak az "on" érték engedi
NEXT_PUBLIC_INDEXING=
# GA4 mérési azonosító (G-XXXX); üresen nincs mérés és nincs süti-sáv
NEXT_PUBLIC_GA_ID=

# Stripe mock (csak helyi fejlesztéshez; üresen éles viselkedés)
STRIPE_API_HOST=
STRIPE_API_PORT=
STRIPE_API_PROTOCOL=

# Számlázás: mock (alap) vagy szamlazz
INVOICE_PROVIDER=mock
SZAMLAZZ_AGENT_KEY=
